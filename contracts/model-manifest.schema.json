{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cinpeCan/Engram/contracts/model-manifest.schema.json",
  "title": "ModelManifestResponse",
  "description": "Catalog of downloadable on-device MNN quantized generation and embedding models.",
  "type": "object",
  "required": ["schemaVersion", "models"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ModelDescriptor"
      }
    }
  },
  "$defs": {
    "ModelFile": {
      "type": "object",
      "required": ["name", "url", "sizeBytes", "sha256"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "ModelDescriptor": {
      "type": "object",
      "required": [
        "id",
        "name",
        "role",
        "quantization",
        "sizeBytes",
        "minRamMb",
        "downloadUrl",
        "mirrorUrl",
        "sha256",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "role": { "type": "string", "enum": ["generation", "embedding"] },
        "quantization": { "type": "string", "minLength": 1 },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "minRamMb": { "type": "integer", "minimum": 256 },
        "downloadUrl": { "type": "string", "format": "uri" },
        "mirrorUrl": { "type": "string", "format": "uri" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "description": { "type": "string" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/ModelFile" }
        }
      }
    }
  }
}
