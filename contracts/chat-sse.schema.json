{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cinpeCan/Engram/contracts/chat-sse.schema.json",
  "title": "ChatStreamContracts",
  "description": "Cloud fallback SSE request and delta frame contracts shared between Engram Android and FastAPI gateway.",
  "$defs": {
    "CitationItem": {
      "type": "object",
      "required": ["memoryId", "content"],
      "additionalProperties": false,
      "properties": {
        "memoryId": { "type": "string", "minLength": 1 },
        "content": { "type": "string", "minLength": 1 }
      }
    },
    "ChatStreamRequest": {
      "type": "object",
      "required": ["query", "citations", "model", "stream"],
      "additionalProperties": false,
      "properties": {
        "query": { "type": "string", "minLength": 1 },
        "citations": {
          "type": "array",
          "items": { "$ref": "#/$defs/CitationItem" }
        },
        "model": { "type": "string", "minLength": 1 },
        "stream": { "type": "boolean" }
      }
    },
    "ChatStreamChunk": {
      "type": "object",
      "required": ["delta", "done", "model", "latencyMs"],
      "additionalProperties": false,
      "properties": {
        "delta": { "type": "string" },
        "done": { "type": "boolean" },
        "model": { "type": "string", "minLength": 1 },
        "latencyMs": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
