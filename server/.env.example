# Optional OpenAI-compatible upstream configuration for Cloud Collaboration SSE fallback.
# When ENGRAM_CLOUD_API_KEY is unset, the gateway uses its built-in citation-grounded
# streaming synthesizer so local development works out of the box without API keys.
ENGRAM_CLOUD_BASE_URL=https://api.openai.com/v1
ENGRAM_CLOUD_API_KEY=
ENGRAM_CLOUD_MODEL=gpt-4o-mini
ENGRAM_PORT=8787
