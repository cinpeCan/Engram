# Primary Vertex AI runtime configuration (uses host/container ADC when GOOGLE_CLOUD_PROJECT is set)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
ENGRAM_VERTEX_MODEL=gemini-3.5-flash-lite

# Stateless 7-day HMAC demo token auth & 4-layer spend fuse
ENGRAM_DEMO_SIGNING_SECRET=
ENGRAM_DEMO_MAX_REQUESTS_PER_TOKEN=50
ENGRAM_MONTHLY_HARD_CAP_USD=5.0
ENGRAM_ESTIMATED_COST_PER_REQ_USD=0.0004

# Optional local dev fallback (used only when GOOGLE_CLOUD_PROJECT is unset)
ENGRAM_CLOUD_BASE_URL=
ENGRAM_CLOUD_API_KEY=
ENGRAM_CLOUD_MODEL=
ENGRAM_PORT=8787
