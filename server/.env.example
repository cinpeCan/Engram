# OpenAI-compatible upstream configuration for Cloud SSE structured analysis.
# When ENGRAM_CLOUD_API_KEY is unset, /api/v1/analyze/stream returns HTTP 503 so the
# Android client falls back honestly to on-device MNN or local rule extraction.
ENGRAM_CLOUD_BASE_URL=https://api.openai.com/v1
ENGRAM_CLOUD_API_KEY=
ENGRAM_CLOUD_MODEL=gpt-4o-mini
ENGRAM_PORT=8787
