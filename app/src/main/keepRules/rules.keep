# Project-specific R8 keep rules for Engram (:app).
# AGP combines all keep rule files under src/main/keepRules when shrinking release builds.

-keepattributes *Annotation*,InnerClasses
-dontnote kotlinx.serialization.SerializationKt

# Preserve Kotlinx Serialization Companions, generated serializers, and object singletons for DTOs and NavKeys
-keepattributes RuntimeVisibleAnnotations
-keepclassmembers class io.github.cinpecan.engram.** {
    *** Companion;
}
-keepclassmembers class io.github.cinpecan.engram.**$Companion {
    kotlinx.serialization.KSerializer serializer(...);
}
-keepclassmembers class io.github.cinpecan.engram.**$serializer {
    *;
}
-keep @kotlinx.serialization.Serializable class io.github.cinpecan.engram.ui.navigation.EngramNavKey** {
    *;
}
-keepclassmembers class io.github.cinpecan.engram.ui.navigation.EngramNavKey** {
    public static final *** INSTANCE;
}
